# Copy to .env.local: the Jellyfin server the login screen starts with.
# Vite reads it when it builds the page (npm run build, npm run dev).
VITE_JELLYFIN_URL=https://jellyfin.example.com

# jellyflow's own server (npm start, server.ts) doesn't read this file: it
# takes these from its environment (the shell, pm2's env). Their defaults,
# from server/config.ts (~ is the home folder):
# HOST=127.0.0.1
# PORT=4173
# JELLYFIN_URL=http://127.0.0.1:8096                    # Jellyfin, as the server reaches it
# TMDB_TOKEN_FILE=~/.config/jellyflow/tmdb-token        # TMDB's read access token (or TMDB_TOKEN=…); none: no Discover
# DATABASE=~/.local/share/jellyflow/jellyflow.db        # SQLite: TMDB's answers, the lists, the wishlist
# IMAGES=~/.cache/jellyflow/images                      # TMDB's posters, once fetched (safe to delete)
