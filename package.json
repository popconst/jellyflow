{
  "name": "jellyflow",
  "version": "0.1.0",
  "description": "A keyboard-first Jellyfin web client: films and series in Netflix-style rows of Cover Flow, music by album cover or by folder, Discover from TMDB with a wishlist, and vim keys throughout.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popconst/jellyflow.git"
  },
  "homepage": "https://github.com/popconst/jellyflow#readme",
  "bugs": "https://github.com/popconst/jellyflow/issues",
  "keywords": [
    "jellyfin",
    "jellyfin-client",
    "cover-flow",
    "svelte",
    "vim",
    "keyboard",
    "media-player",
    "music-player",
    "tmdb",
    "hls"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.core.json && tsc -p tsconfig.server.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/lib/*/*.test.ts\" \"src/core/*.test.ts\" \"server/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "audiomotion-analyzer": "^4.5.4",
    "hls.js": "^1.7.4"
  }
}
