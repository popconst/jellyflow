{
  "name": "jellyflow",
  "version": "0.1.0",
  "description": "Flip through a Jellyfin music library by album cover (Cover Flow) or by folder, with vim keys. In the browser now; in the terminal next.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.core.json",
    "test": "node --test \"src/core/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "audiomotion-analyzer": "^4.5.4"
  }
}
